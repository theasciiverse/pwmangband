[0.000, "o", "\u001b[96m\u001b[40mRanger\u001b[30m\u001b[40m \u001b[31m\u001b[40m      \u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m...\u001b[32m\u001b[40m.\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[35m\u001b[40m*\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m...\u001b[32m\u001b[40m....\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[35m\u001b[40m*\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[91m\u001b[40m...\u001b[32m\u001b[40m.\u001b[10b\u001b[35m\u001b[40m*\u001b[32m\u001b[40m...\u001b[91m\u001b[40m...\u001b[32m\u001b[40m.\u001b[17b\u001b[37m\u001b[40m..\u001b[32m\u001b[40m..\r\u001b[5d"]
[0.000, "o", "\u001b[31m\u001b[40mLEVEL \u001b[95m\u001b[40m     1\u001b[31m\u001b[40m \u001b[32m\u001b[40m....\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[15b\u001b[35m\u001b[40m*\u001b[32m\u001b[40m.\u001b[91m\u001b[40m...\u001b[32m\u001b[40m....\u001b[37m\u001b[40m.\u001b[35m\u001b[40m*\u001b[32m\u001b[40m.....\u001b[37m\u001b[40m.\u001b[32m\u001b[40m...\u001b[91m\u001b[40m...\u001b[32m\u001b[40m..\u001b[37m\u001b[40m..\u001b[32m\u001b[40m..\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[35m\u001b[40m*\u001b[32m\u001b[40m.\u001b[9b\u001b[37m\u001b[40m.\u001b[32m\u001b[40m..\r\u001b[6d"]
[0.000, "o", "\u001b[31m\u001b[40mNXT\u001b[30m\u001b[40m \u001b[95m\u001b[40m      12\u001b[31m\u001b[40m \u001b[37m\u001b[40m..\u001b[32m\u001b[40m.\u001b[37m\u001b[40m.\u001b[32m\u001b[40m...\u001b[37m\u001b[40m.\u001b[32m\u001b[40m...\u001b[37m\u001b[40m.\u001b[32m\u001b[40m..\u001b[35m\u001b[40m*\u001b[32m\u001b[40m..\u001b[35m\u001b[40m*\u001b[32m\u001b[40m.....\u001b[91m\u001b[40m...\u001b[32m\u001b[40m.\u001b[14b\u001b[91m\u001b[40m...\u001b[32m\u001b[40m...\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m.\u001b[32m\u001b[40m..\u001b[35m\u001b[40m*\u001b[32m\u001b[40m...\u001b[37m\u001b[40m.\u001b[32m\u001b[40m......\u001b[35m\u001b[40m*\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\r\u001b[7d"]
