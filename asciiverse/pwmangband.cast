[0.000, "o", "\u001b[96m\u001b[40mElf\u001b[31m\u001b[40m    \u001b[30m\u001b[40m \u001b[31m\u001b[40m   \u001b[30m\u001b[40m \u001b[31m\u001b[40m \u001b[37m\u001b[40m.....\u001b[32m\u001b[40m....\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;7m\u001b[37m\u001b[40m \u001b(B\u001b[0m\u001b[91m\u001b[40m......\u001b(B\u001b[0;7m\u001b[37m\u001b[40m \u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[91m\u001b[40m...\u001b[32m\u001b[40m..\u001b[37m\u001b[40m.\u001b[32m\u001b[40m..\u001b[37m\u001b[40m.\u001b[32m\u001b[40m....\u001b[37m\u001b[40m.\u001b[32m\u001b[40m..\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b[91m\u001b[40m...\u001b[32m\u001b[40m...\u001b(B\u001b[0;7m\u001b[37m\u001b[40m \u001b[9b\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[37m\u001b[40m.\u001b[32m\u001b[40m....\u001b(B\u001b[0;7m\u001b[37m\u001b[40m \r\u001b[3d\u001b(B\u001b[0m\u001b[96m\u001b[40mRunner\u001b[14G"]
